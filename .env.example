# Copy to .env.local. Empty key = deterministic offline demo.
# Never use a VITE_ prefix for a secret.
GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# Logs are disabled by default, including automatic browser backups/uploads.
# Only enable for a consented study on a trusted local network.
ASIDE_ENABLE_LOGGING=false
VITE_ENABLE_LOGGING=false

# Optional WebSocket URL for a separately hosted sync server.
# VITE_WS_URL=wss://your-host.example/ws
