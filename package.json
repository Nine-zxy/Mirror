{
  "name": "aside",
  "version": "0.1.0",
  "private": true,
  "description": "Research artifact for Dyadic Spectator Reflection",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm run server\"",
    "dev:lan": "concurrently -k \"vite --host 0.0.0.0\" \"npm run server\"",
    "server": "node --env-file-if-exists=.env.local server/index.js",
    "build": "vite build",
    "preview": "concurrently -k \"vite preview --host 127.0.0.1\" \"npm run server\"",
    "test": "node --test",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run test && npm run build && npm run check:release"
  },
  "dependencies": {
    "lucide-react": "0.344.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.4.18",
    "concurrently": "9.2.4",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.1",
    "vite": "8.3.1"
  }
}
